<!--
This file is synced with LynxPrompt (Blueprint: bp_golden)

Sync Commands:

# Using curl with environment variable (token stored in $LYNXPROMPT_API_TOKEN):

# Push local changes to cloud:
jq -Rs '{content: .}' CLAUDE.md | curl -sf -X PUT "https://lynxprompt.com/api/v1/blueprints/bp_golden" -H "Authorization: Bearer $LYNXPROMPT_API_TOKEN" -H "Content-Type: application/json" --data-binary @-

# Pull cloud changes to local:
curl -sf "https://lynxprompt.com/api/v1/blueprints/bp_golden" -H "Authorization: Bearer $LYNXPROMPT_API_TOKEN" | jq -er '.blueprint.content' > CLAUDE.md.new && mv CLAUDE.md.new CLAUDE.md

# Set your token: export LYNXPROMPT_API_TOKEN="your_token_here"
# Generate token at: https://lynxprompt.com/settings

Docs: https://lynxprompt.com/docs/api
-->

